# Database. Local dev defaults to SQLite (a file that survives restarts).
# For cloud deploy, set this to your Postgres URL, e.g.
#   DATABASE_URL=postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./patients.db

# Optional shared secret. If set, the /vapi/webhook endpoint requires
# header  X-Vapi-Secret: <this value>  (configure the same value in Vapi).
VAPI_WEBHOOK_SECRET=

# Optional: set to 1 to insert demo seed rows on startup if the table is empty.
SEED_ON_STARTUP=1
